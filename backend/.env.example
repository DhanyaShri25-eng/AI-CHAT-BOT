# BuildWise AI Environment Configuration
PROJECT_NAME="BuildWise AI"
ENV="development"
PORT=8000
SECRET_KEY="buildwise-ai-super-secret-key-makeathon-2026"

# Database Configuration (PostgreSQL / Supabase / SQLite)
# For local zero-config SQLite:
DATABASE_URL="sqlite+aiosqlite:///./buildwise.db"
# For PostgreSQL / Supabase:
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/buildwise"

# AI / Model Inference Configuration
# Options: "built-in" (autonomous expert engine), "ollama", "openai-compatible", "gemini", "groq"
LLM_PROVIDER="built-in"
LLM_MODEL_NAME="buildwise-llama3-construction-8b"
LLM_API_BASE_URL="http://localhost:11434/v1"
LLM_API_KEY=""

# Voice / Audio
WHISPER_MODEL="base"
TTS_DEFAULT_VOICE="ta-IN-ValluvarNeural"
